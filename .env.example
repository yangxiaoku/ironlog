PORT=8080
HOST=127.0.0.1
DATABASE_PATH=./data/gym.db
# Development login is explicitly enabled only for local development.
ALLOW_DEV_LOGIN=true
ALLOW_INSECURE_HTTP=false
TRUST_PROXY=false
# Compose publishes the backend on this host interface.
IRONLOG_BIND=127.0.0.1
ALLOW_REGISTRATION=true
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=90000
